# Copy this file to terraform.tfvars and fill in your values
# NEVER commit terraform.tfvars to source control — add it to .gitignore

aws_region   = "us-east-1"
project_name = "myapp"
environment  = "prod"

availability_zones = ["us-east-1a", "us-east-1b"]
vpc_cidr           = "10.0.0.0/16"

# EC2
ec2_instance_type    = "t3.small"
ec2_key_name         = "my-keypair"          # Must exist in AWS already
ec2_ami_id           = "ami-0c02fb55956c7d316" # Amazon Linux 2023, us-east-1

asg_min_size         = 2
asg_max_size         = 6
asg_desired_capacity = 2
app_port             = 3000

# Leave empty to skip HTTPS (not recommended for prod)
# certificate_arn = "arn:aws:acm:us-east-1:123456789:certificate/abc-123"
certificate_arn = ""

# DocumentDB
docdb_instance_class  = "db.r6g.large"
docdb_instance_count  = 2  # 1 primary + 1 replica
docdb_master_username = "dbadmin"
docdb_master_password = "ChangeMe!SecurePass123"  # Use a strong password
